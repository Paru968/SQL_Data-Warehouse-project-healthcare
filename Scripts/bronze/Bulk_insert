TRUNCATE TABLE bronze.bed;
GO

BULK INSERT bronze.bed
FROM 'C:\Users\user\Desktop\HealthCare\hospital_datasets_with_metadata (1)\hospital_synthetic_shalaka\hospital_data\bed_clean.csv'
WITH
(
    FIRSTROW = 2,
    FIELDTERMINATOR = ',',
    ROWTERMINATOR = '0x0A',
    TABLOCK,
    KEEPNULLS,
    MAXERRORS = 1000
);
GO

